config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:private"],
)

config_setting(
    name = "macos_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:osx",
    ],
    visibility = ["//visibility:private"],
)

config_setting(
    name = "windows_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    visibility = ["//visibility:private"],
)

alias(
    name = "actionlint",
    actual = select({
        ":linux_x86_64": "@actionlint_linux_x86_64//:actionlint",
        ":macos_aarch64": "@actionlint_macos_aarch64//:actionlint",
        ":windows_x86_64": "@actionlint_windows_x86_64//:actionlint.exe",
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "shellcheck",
    actual = select({
        ":linux_x86_64": "@shellcheck_linux_x86_64//:shellcheck",
        ":macos_aarch64": "@shellcheck_macos_aarch64//:shellcheck",
        ":windows_x86_64": "@shellcheck_windows_x86_64//:shellcheck.exe",
    }),
    visibility = ["//visibility:public"],
)
