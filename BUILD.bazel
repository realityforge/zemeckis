load("@buildifier_prebuilt//:rules.bzl", "buildifier")
load("@rules_palantir_java_format//:defs.bzl", "java_format_check")

package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE"])

WARNINGS = [
    "+unsorted-dict-items",
    "-module-docstring",
    "-function-docstring",
]

buildifier(
    name = "buildifier",
    exclude_patterns = [
        "./.git/*",
        "./.bazelbsp/*",
    ],
    lint_mode = "fix",
    lint_warnings = WARNINGS,
)

buildifier(
    name = "buildifier_check",
    diff_command = "diff -u",
    exclude_patterns = [
        "./.git/*",
        "./.bazelbsp/*",
    ],
    lint_mode = "warn",
    lint_warnings = WARNINGS,
    mode = "diff",
)

filegroup(
    name = "artifacts",
    srcs = ["//core/src/main/java/zemeckis:core"],
)

test_suite(
    name = "all_tests",
    tests = [
        "//core/src/test/java/zemeckis:all_tests",
        "//core/src/test/java/zemeckis/test:all_tests",
        "//tools/release:all_tests",
    ],
)

java_format_check(
    name = "java_format_check",
    testonly = True,
    remediation = "tools/java_format.sh write",
    targets = [
        ":all_tests",
        "//core/src/test/j2cl:build_test_java",
        "//core/src/test/java/zemeckis/gwt:smoke",
        "//examples/src/main/java/zemeckis/examples/dom/basic",
        "//examples/src/main/java/zemeckis/examples/dom/pulse_task",
        "//examples/src/main/java/zemeckis/examples/dom/repeating_task",
        "//tools/release:javadoc_jar_builder",
    ],
)
