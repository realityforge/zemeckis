load("@buildifier_prebuilt//:rules.bzl", "buildifier")

package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE"])

WARNINGS = [
    "+unsorted-dict-items",
    "-module-docstring",
    "-function-docstring",
]

buildifier(
    name = "buildifier",
    exclude_patterns = [
        "./.git/*",
        "./.bazelbsp/*",
    ],
    lint_mode = "fix",
    lint_warnings = WARNINGS,
)

buildifier(
    name = "buildifier_check",
    diff_command = "diff -u",
    exclude_patterns = [
        "./.git/*",
        "./.bazelbsp/*",
    ],
    lint_mode = "warn",
    lint_warnings = WARNINGS,
    mode = "diff",
)

filegroup(
    name = "artifacts",
    srcs = ["//core/src/main/java/zemeckis:core"],
)

test_suite(
    name = "all_tests",
    tests = [
        "//core/src/test/java/zemeckis:all_tests",
        "//core/src/test/java/zemeckis/test:all_tests",
        "//tools/release:all_tests",
    ],
)
