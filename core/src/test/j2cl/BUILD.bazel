load("@j2cl//build_defs:rules.bzl", "j2cl_application")
load("@rules_closure//closure:defs.bzl", "closure_js_library")

package(default_visibility = ["//visibility:public"])

closure_js_library(
    name = "entry_point",
    srcs = ["entry_point.js"],
    deps = ["//core/src/main/java/zemeckis:core-j2cl"],
)

j2cl_application(
    name = "zemeckis_j2cl_smoke",
    closure_defines = {
        "zemeckis.environment": "'development'",
        "zemeckis.logger": "'proxy'",
    },
    entry_points = ["zemeckis.j2cl.BuildTest"],
    suppress_on_all_sources_in_transitive_closure = ["checkTypes"],
    deps = [":entry_point"],
)
